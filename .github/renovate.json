{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "default:automergeDigest",
    "docker:pinDigests"
  ],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Longhorn feature releases (1.x minors) are one-way storage upgrades - keep them manual, only automerge patches",
      "matchPackageNames": [
        "longhorn"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "description": "PostgreSQL major upgrades need a manual data migration (pg_upgrade/dump-restore) - never propose them automatically",
      "matchPackageNames": [
        "registry-1.docker.io/bitnamicharts/postgresql",
        "postgres",
        "pgvector/pgvector"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "UniFi controller minors can carry a MongoDB schema migration - keep them manual",
      "matchPackageNames": [
        "lscr.io/linuxserver/unifi-network-application"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/apps/templates/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/templates/.+\\.yaml$/"
    ]
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "nix": {
    "enabled": false
  },
  "customManagers": [
    {
      "description": "Tool versions baked into the argocd repo-server init container",
      "customType": "regex",
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "managerFilePatterns": [
        "/apps/templates/helm-argo-cd.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*- name: \\S+\\s*\\n\\s*value: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
